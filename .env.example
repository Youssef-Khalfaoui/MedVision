# ============================================================================
# MedVision environment — copy to .env and fill in BEFORE starting the stack:
#   cp .env.example .env
# ============================================================================

# --- Database ---------------------------------------------------------------
DB_USER=medvision
DB_PASSWORD=changeme
DB_NAME=medvision

# --- JWT signing (backend) --------------------------------------------------
# REQUIRED. The backend refuses to start outside debug mode with a weak or
# example secret. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# --- Shared secret: backend/worker -> AI pipeline ---------------------------
# REQUIRED since the security review (the pipeline used to run unauthenticated).
# Use the SAME value for both. Generate a separate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PIPELINE_AUTH_TOKEN=

# --- Redis ------------------------------------------------------------------
# The Redis container is started with --requirepass; backend/worker read this.
REDIS_PASSWORD=changeme-redis

# --- CORS -------------------------------------------------------------------
# Browser origins allowed to call the API, comma-separated. "*" is refused
# outside debug mode. Add your production origin here, e.g.:
#   ALLOWED_ORIGINS=http://193.95.31.163:8080
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080

